{
  "name": "osu-server-list",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.2.23",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "format": "prettier --write .",
    "packages:rebuild": "turbo --filter='./packages/*' build",
    "db:push": "turbo db:push",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-fetch/fetch": "^1.1.18",
      "@types/bun": "latest",
      "@vermaysha/discord-webhook": "1.4.0",
      "discord-api-types": "^0.38.31",
      "typescript": "^7.0.2",
      "tsdown": "^0.22.7",
      "zod": "^4.1.12",
      "prettier": "^3.9.5",
      "prettier-plugin-svelte": "^4.1.1",
      "prettier-plugin-tailwindcss": "^0.8.0"
    }
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsdown": "^0.22.7",
    "turbo": "^2.6.0",
    "valibot": "^1.1.0"
  }
}
